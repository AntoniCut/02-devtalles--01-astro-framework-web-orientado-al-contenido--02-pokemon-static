---


/*
    *  ----------------------------------------------------------  *
    *  -----  index.astro  --  /src/pages/demo/index.astro  -----  *
    *  ----------------------------------------------------------  *
*/


import Layout from "@layouts/Layout.astro"
import Title from "@components/shared/Title.astro"
import { Counter } from "@components/shared/Counter"
import Video from "@components/shared/Video.astro";


/** -----  Valor inicial del contador ----- */
const counterValue: number = 15;

---


<Layout 
    titlePage="Pokemon Static | Demo"
>

    <Title>
        Demo
    </Title>

   <div class="w-full flex flex-col items-center gap-4 p-5">

        <Counter 
            client:visible 
            initialValue={counterValue}
            transition:persist="counter-value"
            transition:persist-props
        >
        
            <Title>
                Contador Demo - SolidJS
            </Title>

        </Counter>

    </div>

    <Video />
    

</Layout>
