---


/*
    *  -------------------------------------------------------------  *
    *  -----  index.astro  --  /src/pages/islands/index.astro  -----  *
    *  -------------------------------------------------------------  *
*/


import Layout from "@layouts/Layout.astro"
import Title from "@components/shared/Title.astro"
import { Counter } from "@components/shared/Counter"
import Video from "@components/shared/Video.astro";


/** -----  Valor inicial del contador ----- */
const counterValue: number = 20;

---


<Layout 
    titlePage="Pokemon Static | Islas"
>

    <Title>
        Islas con Solid JS
    </Title>


    <section class="w-full h-48 flex flex-col justify-center items-center mt-5 mb-5">

        <h2 class="mt-12 mb-4  text-4xl text-center"> 
            Scroll hacia abajo para ver 
            <br> 
            la Isla Counter en SolidJS 
        </h2>

    </section>
    


    <Video />

    
    <div class="w-full flex flex-col justify-center items-center gap-4 p-5 mt-500">

        <Counter 
            client:visible 
            initialValue={counterValue}
            transition:persist="counter-value"
            transition:persist-props
        >

            <Title>
                Contador Islas - SolidJS
            </Title>

        </Counter>

    </div>

</Layout>
