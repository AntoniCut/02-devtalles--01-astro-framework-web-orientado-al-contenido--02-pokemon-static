---

/*
    *  ----------------------------------------------------------------------------------  *
    *  -----  PokemonHeader.astro  --  /src/components/pokemons/PokemonHeader.astro  -----  *
    *  ----------------------------------------------------------------------------------  *
*/


import { Icon } from "astro-icon/components";


interface Props {

    /**  -----  Nombre del Pokémon  -----  */
    name: string;

    /**  -----  ID del Pokémon  -----  */
    id: string;
}

const { name, id } = Astro.props;


---


<!--  -----  Sección de detalles del Pokémon  -----  -->
<section class="mt-10 mx-10 flex flex-col justify-center items-center">

    <!--  -----  Encabezado del Pokémon  -----  -->
    <header class="mb-5 flex flex-col justify-center items-center cursor-pointer">

        <!--  -----  Enlace para volver al listado de Pokémon  -----  -->
        <button
            onclick="history.back()"
            class="text-blue-500 mb-2.5"
        >
            Regresar
        </button>

        <!--  -----  Container del nombre del Pokémon y Icon de Favoritos  ----- -->
        <div class="flex items-center space-x-2">

            <!--  -----  Nombre del Pokémon  -----  -->
            <h2 class="text-5xl capitalize text-emerald-300">
                {id} - {name}
            </h2>

            <!--  -----  Icon de Favoritos  -----  -->
            <button 
                id="btnFavorite"
                class="ml-4"
                data-name={name}
                data-id={id}
            >

                <Icon 
                    data-outline 
                    name="heart-outline" 
                    size={50} 
                />

                <Icon 
                    data-full 
                    name="heart-full" 
                    size={50} 
                    class="hidden"
                />

            </button>
            
           

        </div>

    </header>

</section>


<style>

    @reference "tailwindcss";

    #btnFavorite {
        @apply 
        hover:animate-pulse;
        cursor: pointer
    }

</style>



<!--  -----  Listeners del botón de favoritos (módulo externo)  -----  -->
<script>
    
    import '@scripts/favorites-button';

</script>
