---

/*
    *  -----------------------------------------------------------------  *
    *  -----  Video.astro  --  /src/components/shared/Video.astro  -----  *
    *  -----------------------------------------------------------------  *
 */

 import { base } from "@config/base-project";

---


<video
    controls
    muted
    autoplay
    transition:name="video"
    transition:persist="playing-video"
    class="w-full h-100 m-auto mt-5 mb-20"
>
    <source
        src={`${base}/videos/cars-driven.webm`}
        type="video/webm"
    />

</video>

